# Environment configuration for Interview Helper.
# Copy to .env and fill in real values. Never commit .env.

# ---- Database ----
# Full SQLAlchemy connection URL (required). Takes precedence over the
# individual DB_* variables when set.
DATABASE_URL=postgresql://postgres:postgres@db:5432/interview_prep

# Individual database variables (used by the db service and to build
# DATABASE_URL when it is not set explicitly).
DB_NAME=interview_prep
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# ---- Application ----
BACKEND_PORT=8000
FRONTEND_PORT=80
FRONTEND_DEV_PORT=5173

# Comma-separated allowed CORS origins. Must be an explicit list
# (no "*") because the backend enables credentials.
CORS_ORIGINS=http://localhost:80,http://localhost:5173

LOG_LEVEL=INFO
# Set to "production" to enable strict checks (e.g. reject default
# credentials in DATABASE_URL).
# ENVIRONMENT=production

# ---- LLM (question generation) ----
# Primary model in LiteLLM format (provider/model).
LLM_MODEL=gemini/gemini-1.5-flash
# Comma-separated fallback models tried when the primary fails.
LLM_FALLBACK_MODELS=openai/gpt-4o-mini,anthropic/claude-3-5-haiku-20241022
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7

# Provider API keys. Set the one(s) matching your LLM_MODEL.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
# AZURE_API_KEY=
# VERTEX_AI_PROJECT_ID=
# AWS_ACCESS_KEY_ID=

# ---- Auth ----
SESSION_TTL_HOURS=24
