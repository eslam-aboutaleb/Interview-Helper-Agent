# Copy to terraform.tfvars and fill in real values.
# Never commit terraform.tfvars with real secrets.

aws_region   = "eu-north-1"
environment  = "prod"
instance_type = "t3.medium"

# Restrict SSH to your IP instead of 0.0.0.0/0
allowed_ssh_cidr = "0.0.0.0/0"

# Name of an existing EC2 key pair (leave empty to use SSM instead)
key_name = ""

# Set to true to provision a managed RDS PostgreSQL instance
# instead of the containerized database.
use_rds = false

# Database credentials (override via TF_VAR_ environment variables
# or a git-ignored tfvars file)
db_password = "change-me-in-production"

# LLM provider keys are read from the environment by the backend.
# Pass the Gemini key through TF_VAR_gemini_api_key or a tfvars file.
gemini_api_key = ""

# Comma-separated allowed CORS origins
cors_origins = "*"

# Optional: custom domain (requires hosted_zone_id)
domain_name    = ""
hosted_zone_id = ""
